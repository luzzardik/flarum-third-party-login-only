{
    "name": "luzzardik/flarum-third-party-login-only",
    "description": "Only allow login and sign ups from oAuth extensions.",
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "V17 Development",
            "email": "info@v17.dev",
            "role": "Original Developer"
        },
        {
            "name": "luzzardik",
            "role": "Developer"
        }
    ],
    "homepage": "https://v17.dev/projects/flarum-third-party-login-only",
    "support": {
        "forum": "https://discuss.flarum.org/d/28424",
        "docs": "https://community.v17.dev/knowledgebase/category/flarum-third-party-login-only"
    },
    "autoload": {
        "psr-4": {
            "luzzardik\\FlarumThirdPartyLoginOnly\\": "src/"
        }
    },
    "minimum-stability": "beta",
    "require": {
        "flarum/core": "^2.0"
    },
    "extra": {
        "flarum-extension": {
            "title": "Third party login only",
            "category": "feature",
            "icon": {
                "name": "fas fa-sign-in-alt",
                "backgroundColor": "#503cc5",
                "color": "#ffffff"
            }
        }
    }
}
